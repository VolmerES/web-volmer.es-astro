---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
    { n: 1, title: t('process.s1.title'), desc: t('process.s1.desc'), ring: 'border-neon-cyan/50 text-neon-cyan', fill: 'group-hover:bg-neon-cyan' },
    { n: 2, title: t('process.s2.title'), desc: t('process.s2.desc'), ring: 'border-neon-pink/50 text-neon-pink', fill: 'group-hover:bg-neon-pink' },
    { n: 3, title: t('process.s3.title'), desc: t('process.s3.desc'), ring: 'border-purple-500/50 text-purple-400', fill: 'group-hover:bg-purple-500' },
    { n: 4, title: t('process.s4.title'), desc: t('process.s4.desc'), ring: 'border-yellow-400/50 text-yellow-400', fill: 'group-hover:bg-yellow-400' },
];
---

<div class="flex flex-col md:flex-row justify-between gap-8 relative">
    <!-- Línea conectora -->
    <div class="hidden md:block absolute top-8 left-[12%] right-[12%] h-px bg-gradient-to-r from-neon-cyan/30 via-purple-500/30 to-yellow-400/30 z-0"></div>

    {steps.map(({ n, title, desc, ring, fill }) => (
        <div class="relative z-10 flex-1 text-center group">
            <div
                class:list={[
                    "w-16 h-16 mx-auto bg-dark-bg border rounded-full flex items-center justify-center text-xl font-bold font-heading mb-4 transition-colors duration-300 group-hover:text-dark-bg",
                    ring,
                    fill,
                ]}
            >
                {n}
            </div>
            <h3 class="text-lg font-bold mb-2 text-white">{title}</h3>
            <p class="text-sm text-gray-400 leading-relaxed max-w-[16rem] mx-auto">{desc}</p>
        </div>
    ))}
</div>
