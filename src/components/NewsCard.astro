---
import { getLangFromUrl, useTranslations, useRoutes } from '../i18n/ui';
import { newsDate, newsSlug, type NewsEntry } from '../lib/news';

interface Props {
    item: NewsEntry;
    /** Nivel del título: h2 en el índice de noticias, donde cuelgan del h1. */
    heading?: 'h2' | 'h3';
}

const { item, heading: Heading = 'h3' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const r = useRoutes(lang);
const href = `${r.news}${newsSlug(item)}/`;
---

<article class="group relative flex flex-col h-full rounded-xl overflow-hidden bg-[#111] border border-white/10 hover:border-yellow-400/50 transition-all duration-300 hover:-translate-y-1">
    <a href={href} class="flex flex-col h-full">
        <div class="relative h-44 bg-[#0d0d0d] overflow-hidden shrink-0 border-b border-white/5">
            {item.data.image ? (
                <img
                    src={item.data.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    data-parallax="0.06"
                    data-parallax-max="18"
                    class="absolute inset-x-0 -top-5 w-full h-[calc(100%+2.5rem)] object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                />
            ) : (
                <!-- Sin foto: la etiqueta en grande sobre la rejilla del sitio -->
                <div aria-hidden="true" class="absolute inset-0 flex items-end p-5 bg-[linear-gradient(rgba(5,217,232,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(5,217,232,0.06)_1px,transparent_1px)] bg-[size:22px_22px]">
                    <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-neon-pink/15 blur-[60px]"></div>
                    <span class="relative font-heading font-black text-4xl text-white/10 group-hover:text-white/20 transition-colors uppercase tracking-tight">{item.data.tag}</span>
                </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-[#111] via-transparent to-transparent"></div>
            <span class="absolute top-3 left-3 px-2 py-1 text-[10px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md border border-white/10 rounded text-yellow-400">
                {item.data.tag}
            </span>
        </div>
        <div class="p-5 flex flex-col flex-grow">
            <time datetime={item.data.date.toISOString().slice(0, 10)} class="font-mono text-[11px] text-gray-500 mb-2 first-letter:uppercase">
                {newsDate(item.data.date, lang)}
            </time>
            <Heading class="text-lg font-bold font-heading mb-2 leading-tight text-white group-hover:text-yellow-400 transition-colors line-clamp-3">
                {item.data.title}
            </Heading>
            <p class="text-sm text-gray-400 leading-relaxed line-clamp-3 mb-4">{item.data.description}</p>
            <span class="text-yellow-400 text-xs font-bold flex items-center gap-1 mt-auto">
                {t('news.readMore')} <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
        </div>
    </a>
</article>
