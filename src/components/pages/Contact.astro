---
import { getLangFromUrl, useTranslations, brand } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main class="relative pt-28 md:pt-36 pb-20">

    <!-- ============ HERO ============ -->
    <section class="max-w-7xl mx-auto px-6 mb-14 md:mb-20">
        <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neon-cyan/30 bg-neon-cyan/5 text-neon-cyan text-xs font-bold tracking-wider mb-6">
                <span class="w-2 h-2 rounded-full bg-neon-cyan animate-pulse"></span>
                {t('contact.badge')}
            </div>
            <h1 class="font-heading text-4xl md:text-6xl font-bold leading-[1.05] mb-8">
                {t('contact.title1')} <br />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-neon-pink">
                    {t('contact.title2')}
                </span>
            </h1>
            <p class="text-lg md:text-xl text-gray-400 leading-relaxed max-w-2xl">
                {t('contact.subtitle')}
            </p>
        </div>
    </section>

    <!-- ============ FORMULARIO + CONTACTO DIRECTO ============ -->
    <section class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-[1.4fr_1fr] gap-8 lg:gap-12 items-start">

            <!-- Formulario -->
            <div class="p-6 md:p-8 rounded-2xl bg-[#0a0a0a] border border-white/10">
                <h2 class="text-xl md:text-2xl font-heading font-bold text-white mb-6">{t('contact.formTitle')}</h2>

                <form id="contact-page-form" class="space-y-5">
                    <div>
                        <label for="cp-email" class="block text-xs font-bold text-neon-pink uppercase tracking-wider mb-2">{t('contact.labelEmail')}</label>
                        <input
                            type="email"
                            id="cp-email"
                            name="email"
                            required
                            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-neon-cyan transition-colors"
                            placeholder={t('contact.phEmail')}
                        />
                    </div>

                    <div>
                        <label for="cp-subject" class="block text-xs font-bold text-neon-pink uppercase tracking-wider mb-2">{t('contact.labelSubject')}</label>
                        <input
                            type="text"
                            id="cp-subject"
                            name="subject"
                            required
                            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-neon-cyan transition-colors"
                            placeholder={t('contact.phSubject')}
                        />
                    </div>

                    <div>
                        <label for="cp-phone" class="block text-xs font-bold text-neon-pink uppercase tracking-wider mb-2">{t('contact.labelPhone')}</label>
                        <input
                            type="tel"
                            id="cp-phone"
                            name="phone"
                            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-neon-cyan transition-colors"
                            placeholder="+34 ..."
                        />
                    </div>

                    <div>
                        <label for="cp-message" class="block text-xs font-bold text-neon-pink uppercase tracking-wider mb-2">{t('contact.labelMessage')}</label>
                        <textarea
                            id="cp-message"
                            name="message"
                            rows="6"
                            required
                            maxlength="5000"
                            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-neon-cyan transition-colors resize-none"
                            placeholder={t('contact.phMessage')}
                        ></textarea>
                    </div>

<div aria-hidden="true" class="absolute -left-[9999px] w-px h-px overflow-hidden">
                        <label>Website <input type="text" id="cp-website" name="website" tabindex="-1" autocomplete="off" /></label>
                    </div>

                    <button
                        type="submit"
                        id="cp-submit"
                        data-label-idle={t('contact.send')}
                        data-label-sending={t('contact.sending')}
                        data-label-sent={t('contact.sent')}
                        data-label-error={t('contact.error')}
                        data-panel={import.meta.env.PUBLIC_LEADS_URL ?? brand.leads}
                        data-formspree={brand.formspree}
                        class="w-full bg-gradient-to-r from-neon-cyan to-blue-600 text-white font-bold py-3.5 rounded-lg hover:shadow-[0_0_20px_rgba(5,217,232,0.4)] transition-all transform hover:scale-[1.01] disabled:opacity-50 disabled:grayscale disabled:transform-none"
                    >
                        {t('contact.send')}
                    </button>
                </form>
            </div>

            <!-- Contacto directo -->
            <div class="space-y-4">
                <h2 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-4">{t('contact.directTitle')}</h2>

                <a href={`https://wa.me/${brand.whatsapp}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 rounded-xl bg-[#0a0a0a] border border-white/10 hover:border-[#25D366]/50 hover:bg-[#25D366]/5 transition-all group">
                    <div class="w-11 h-11 rounded-full bg-[#25D366]/15 text-[#25D366] flex items-center justify-center shrink-0 group-hover:bg-[#25D366] group-hover:text-white transition-colors">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-bold text-white">WhatsApp</p>
                        <p class="text-xs text-gray-500 truncate">{brand.phone}</p>
                    </div>
                </a>

                <a href={`mailto:${brand.email}`} class="flex items-center gap-4 p-4 rounded-xl bg-[#0a0a0a] border border-white/10 hover:border-neon-cyan/50 hover:bg-neon-cyan/5 transition-all group">
                    <div class="w-11 h-11 rounded-full bg-neon-cyan/15 text-neon-cyan flex items-center justify-center shrink-0 group-hover:bg-neon-cyan group-hover:text-dark-bg transition-colors">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-bold text-white">Email</p>
                        <p class="text-xs text-gray-500 truncate">{brand.email}</p>
                    </div>
                </a>

                <div class="flex items-center gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
                    <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <p class="text-xs text-gray-400">{t('contact.responseTime')}</p>
                </div>

                <!-- Atajo al presupuesto -->
                <div class="p-5 rounded-xl bg-gradient-to-br from-neon-cyan/10 to-transparent border border-neon-cyan/20 mt-8">
                    <h3 class="text-base font-heading font-bold text-white mb-2">{t('contact.quoteTitle')}</h3>
                    <p class="text-xs text-gray-400 leading-relaxed mb-4">{t('contact.quoteDesc')}</p>
                    <button class="open-quote-modal w-full px-5 py-3 text-sm font-bold text-dark-bg bg-neon-cyan hover:bg-white transition-all rounded-lg">
                        {t('cta.quote')}
                    </button>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    import { sendLead, LeadRejected } from '../../lib/leads';

    document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('contact-page-form') as HTMLFormElement | null;
        const submitBtn = document.getElementById('cp-submit') as HTMLButtonElement | null;
        if (!form || !submitBtn) return;

        const labels = {
            idle: submitBtn.dataset.labelIdle || '',
            sending: submitBtn.dataset.labelSending || '',
            sent: submitBtn.dataset.labelSent || '',
            error: submitBtn.dataset.labelError || '',
        };
        const endpoints = {
            panel: submitBtn.dataset.panel || '',
            formspree: submitBtn.dataset.formspree || '',
        };

        const setState = (text: string, add: string[] = [], remove: string[] = []) => {
            submitBtn.innerText = text;
            remove.forEach((c) => submitBtn.classList.remove(c));
            add.forEach((c) => submitBtn.classList.add(c));
        };

        const gradient = ['from-neon-cyan', 'to-blue-600'];

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const email = (document.getElementById('cp-email') as HTMLInputElement).value;
            const subject = (document.getElementById('cp-subject') as HTMLInputElement).value;
            const phone = (document.getElementById('cp-phone') as HTMLInputElement).value;
            const message = (document.getElementById('cp-message') as HTMLTextAreaElement).value;
            const website = (document.getElementById('cp-website') as HTMLInputElement | null)?.value;

            setState(labels.sending);
            submitBtn.disabled = true;

            try {
                await sendLead({ source: 'contact', email, subject, phone, message, website }, endpoints);

                setState(labels.sent, ['bg-emerald-500'], gradient);
                form.reset();

                setTimeout(() => {
                    setState(labels.idle, gradient, ['bg-emerald-500']);
                    submitBtn.disabled = false;
                }, 2500);
            } catch (error) {
                console.error(error);
                // El panel explica qué falla (email mal escrito, demasiados envíos).
                setState(error instanceof LeadRejected ? error.message : labels.error, ['bg-red-500'], gradient);

                setTimeout(() => {
                    setState(labels.idle, gradient, ['bg-red-500']);
                    submitBtn.disabled = false;
                }, 3000);
            }
        });
    });
</script>
