---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useRoutes } from '../../i18n/ui';
import ViewCounter from '../ViewCounter.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const r = useRoutes(lang);

const posts = (await getCollection('blog'))
    .filter((post) => post.id.startsWith(`${lang}/`))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateLocale = lang === 'es' ? 'es-ES' : 'en-GB';
const readingLabel = lang === 'es' ? 'min' : 'min';
---

<main class="relative pt-28 md:pt-36 pb-20 min-h-screen">

    <!-- ============ HERO ============ -->
    <section class="max-w-7xl mx-auto px-6 mb-14 md:mb-20">
        <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neon-cyan/30 bg-neon-cyan/5 text-neon-cyan text-xs font-bold tracking-wider mb-6">
                <span class="w-2 h-2 rounded-full bg-neon-cyan"></span>
                {t('blog.title').toUpperCase()}
            </div>
            <h1 class="font-heading text-4xl md:text-6xl font-bold leading-[1.05] mb-8">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-neon-pink">
                    {t('blog.title')}
                </span>
            </h1>
            <p class="text-lg md:text-xl text-gray-400 leading-relaxed max-w-2xl">
                {t('blog.subtitle')}
            </p>
        </div>
    </section>

    <!-- ============ LISTADO ============ -->
    <section class="max-w-7xl mx-auto px-6">
        {posts.length === 0 ? (
            <div class="max-w-2xl mx-auto text-center py-16 md:py-24 px-6 border border-dashed border-white/10 rounded-2xl bg-white/[0.02]">
                <div class="w-14 h-14 mx-auto mb-6 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-500">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                </div>
                <h2 class="text-xl md:text-2xl font-heading font-bold text-white mb-3">{t('blog.empty')}</h2>
                <p class="text-sm text-gray-400 leading-relaxed mb-8 max-w-md mx-auto">{t('blog.emptyDesc')}</p>
                <a href={r.contact} class="inline-flex items-center gap-2 px-6 py-3 text-sm font-bold text-dark-bg bg-neon-cyan hover:bg-white transition-all rounded-lg">
                    {t('cta.contact')}
                </a>
            </div>
        ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                {posts.map((post) => (
                    <article class="group relative flex flex-col h-full rounded-2xl overflow-hidden bg-[#0a0a0a] border border-white/10 hover:border-neon-cyan/50 transition-all duration-500 hover:shadow-[0_0_30px_rgba(5,217,232,0.12)]">
                        <a href={`${r.blog}${post.slug.replace(/^(es|en)\//, '')}/`} class="flex flex-col h-full">
                            <div class="h-44 bg-gradient-to-br from-gray-900 to-black relative overflow-hidden shrink-0">
                                {post.data.heroImage ? (
                                    <div
                                        class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
                                        style={`background-image: url('${post.data.heroImage}');`}
                                    ></div>
                                ) : (
                                    <div class="absolute inset-0 flex items-center justify-center">
                                        <span class="text-gray-700 font-heading font-bold text-3xl">{t('blog.title')}</span>
                                    </div>
                                )}
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] to-transparent"></div>
                                <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                                    <span class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md border border-white/10 rounded text-white">
                                        {post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}
                                    </span>
                                    <span class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider bg-neon-cyan/80 backdrop-blur-md border border-white/10 rounded text-dark-bg">
                                        {Math.ceil(post.body.split(/\s+/).length / 200)} {readingLabel}
                                    </span>
                                    <span class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md border border-white/10 rounded text-white">
                                        <ViewCounter slug={post.slug} lang={lang} readOnly />
                                    </span>
                                </div>
                            </div>

                            <div class="p-6 flex flex-col flex-grow">
                                <h2 class="text-xl font-bold font-heading mb-3 leading-tight group-hover:text-neon-cyan transition-colors">
                                    {post.data.title}
                                </h2>
                                <p class="text-sm text-gray-400 mb-5 line-clamp-3 leading-relaxed flex-grow">
                                    {post.data.description}
                                </p>
                                <span class="text-neon-cyan text-xs font-bold flex items-center gap-2 mt-auto">
                                    {t('cta.readMore')} <span class="group-hover:translate-x-1 transition-transform">→</span>
                                </span>
                            </div>
                        </a>
                    </article>
                ))}
            </div>
        )}
    </section>
</main>
