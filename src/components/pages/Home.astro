<script>
    /**
     * Animaciones de las tarjetas de servicio: el portátil (Lottie) y el dron.
     *
     * - Entrada guiada por el scroll: el dron llega volando desde la derecha y
     *   frena inclinándose; el portátil entra deslizándose en lateral.
     * - Al posarse flotan con dos senos superpuestos, para que el vaivén no
     *   parezca mecánico, y proyectan sobre la tarjeta una sombra con brillo que
     *   crece y encoge con la altura.
     * - Con el ratón encima de su tarjeta se elevan un poco.
     * - Los bucles se paran fuera de pantalla y con la pestaña oculta, y se
     *   limpian al cambiar de página (ClientRouter).
     * - Con «reducir movimiento» se quedan quietos en su sitio.
     */
    type Pose = { x: number; y: number; r: number; s: number };

    interface Flyer {
        el: HTMLElement;
        card: HTMLElement;
        shadow: HTMLElement | null;
        /** Pose según el avance del scroll, ya suavizado: 0 fuera, 1 posado. */
        flight: (p: number) => Pose;
        /** Vaivén una vez posado (y en %, r en grados). */
        hover: (t: number) => { y: number; r: number };
        /** Cuánto sube y se inclina con el ratón encima. */
        lift: { y: number; r: number };
    }

    const easeOutCubic = (p: number) => 1 - Math.pow(1 - p, 3);
    const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

    function fly(f: Flyer): () => void {
        const place = (pose: Pose, opacity: number) => {
            f.el.style.transform = `translate(${pose.x}%, ${pose.y}%) rotate(${pose.r}deg) scale(${pose.s})`;
            f.el.style.opacity = String(opacity);
        };

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            place(f.flight(1), 1);
            if (f.shadow) f.shadow.style.opacity = '0.7';
            return () => {};
        }

        let progress = 0;
        let visible = false;
        let hovered = false;
        let lift = 0;
        let raf = 0;

        const readProgress = () => {
            const top = f.card.getBoundingClientRect().top;
            const start = window.innerHeight * 0.95;
            const end = window.innerHeight * 0.6;
            progress = clamp((start - top) / (start - end), 0, 1);
        };

        const frame = (now: number) => {
            raf = 0;
            const p = easeOutCubic(progress);
            const landed = progress >= 1;
            // La elevación llega y se va con suavidad, no de golpe.
            lift += ((hovered && landed ? 1 : 0) - lift) * 0.12;
            const sway = landed ? f.hover(now / 1000) : { y: 0, r: 0 };
            const pose = f.flight(p);
            const rise = sway.y + f.lift.y * lift; // negativo = más alto
            place({ ...pose, y: pose.y + rise, r: pose.r + sway.r + f.lift.r * lift }, p);

            if (f.shadow) {
                // Más alto → sombra más pequeña y más tenue.
                const scale = clamp(1 + rise * 0.025, 0.55, 1.15);
                const strength = clamp(0.75 + rise * 0.035, 0.25, 0.9);
                f.shadow.style.transform = `scale(${scale}, ${scale * 0.9})`;
                f.shadow.style.opacity = String(strength * p * p);
            }

            const moving = landed || Math.abs(lift - (hovered ? 1 : 0)) > 0.002;
            if (visible && !document.hidden && moving) raf = requestAnimationFrame(frame);
        };

        const kick = () => {
            if (!raf) raf = requestAnimationFrame(frame);
        };
        const onScroll = () => {
            readProgress();
            kick();
        };
        const onEnter = () => {
            hovered = true;
            kick();
        };
        const onLeave = () => {
            hovered = false;
            kick();
        };

        const observer = new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (visible) onScroll();
        }, { rootMargin: '120px 0px' });
        observer.observe(f.card);

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        document.addEventListener('visibilitychange', kick);
        f.card.addEventListener('mouseenter', onEnter);
        f.card.addEventListener('mouseleave', onLeave);
        onScroll();

        return () => {
            if (raf) cancelAnimationFrame(raf);
            observer.disconnect();
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('resize', onScroll);
            document.removeEventListener('visibilitychange', kick);
            f.card.removeEventListener('mouseenter', onEnter);
            f.card.removeEventListener('mouseleave', onLeave);
        };
    }

    let stopFlyers: (() => void)[] = [];

    document.addEventListener('astro:page-load', () => {
        const byId = (id: string) => document.getElementById(id);

        const drone = byId('scroll-drone');
        const droneCard = byId('drone-card-container');
        if (drone && droneCard) {
            stopFlyers.push(fly({
                el: drone,
                card: droneCard,
                shadow: byId('scroll-drone-shadow'),
                // Llega desde la derecha y abajo, creciendo y nivelándose.
                flight: (p) => ({ x: 200 - p * 200, y: 50 - p * 40, r: 20 - p * 15, s: 0.5 + p * 0.9 }),
                hover: (t) => ({
                    y: Math.sin(t) * 4 + Math.sin(t * 2.5) * 1.5,
                    r: Math.cos(t * 0.8) * 2.5,
                }),
                lift: { y: -9, r: -4 },
            }));
        }

        const laptop = byId('scroll-laptop-container');
        const laptopCard = byId('web-card-container');
        if (laptop && laptopCard) {
            stopFlyers.push(fly({
                el: laptop,
                card: laptopCard,
                shadow: byId('scroll-laptop-shadow'),
                // Entra en lateral desde detrás de la tarjeta del dron. Escala fija
                // en 1 para que el Lottie no se pixele.
                flight: (p) => ({ x: 150 - p * 150, y: -10, r: 5, s: 1 }),
                hover: (t) => ({
                    y: Math.sin(t * 0.9) * 2.5 + Math.sin(t * 2.1) * 0.6,
                    r: Math.sin(t * 0.6) * 0.8,
                }),
                lift: { y: -6, r: -2 },
            }));
        }
    });

    document.addEventListener('astro:before-swap', () => {
        stopFlyers.forEach((stop) => stop());
        stopFlyers = [];
    });
</script>

<script>
    // Tarjeta de 42: abre la captura del ranking en vez de salir de la web.
    document.addEventListener('astro:page-load', () => {
        const modal = document.getElementById('wuri-modal') as HTMLDialogElement | null;
        if (!modal) return;
        document.querySelectorAll<HTMLElement>('[data-wuri]').forEach((card) => {
            card.addEventListener('click', (e) => {
                e.preventDefault();
                modal.showModal();
            });
        });
        modal.querySelector('[data-wuri-close]')?.addEventListener('click', () => modal.close());
        // Pulsar fuera de la tarjeta (en el fondo) también cierra.
        modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.close();
        });
    });
</script>

<script>
    import { sendLead, LeadRejected } from '../../lib/leads';

    document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('home-contact-form') as HTMLFormElement | null;
        const button = document.getElementById('hc-submit') as HTMLButtonElement | null;
        if (!form || !button) return;

        const labels = button.dataset;
        const reset = (delay: number) => setTimeout(() => {
            button.innerText = labels.labelIdle || '';
            button.classList.remove('!bg-none', '!bg-emerald-500', '!bg-red-500');
            button.disabled = false;
        }, delay);

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            button.disabled = true;
            button.innerText = labels.labelSending || '';
            try {
                await sendLead({
                    source: 'contact',
                    email: (document.getElementById('hc-email') as HTMLInputElement).value,
                    subject: form.dataset.subject,
                    message: (document.getElementById('hc-message') as HTMLTextAreaElement).value,
                    website: (document.getElementById('hc-website') as HTMLInputElement | null)?.value,
                }, { panel: form.dataset.panel || '', formspree: form.dataset.formspree || '' });
                button.innerText = labels.labelSent || '';
                button.classList.add('!bg-none', '!bg-emerald-500');
                form.reset();
                reset(2500);
            } catch (error) {
                console.error(error);
                button.innerText = error instanceof LeadRejected ? error.message : (labels.labelError || '');
                button.classList.add('!bg-none', '!bg-red-500');
                reset(3500);
            }
        });
    });
</script>

<style>
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .animate-marquee {
        animation: marquee 30s linear infinite;
    }
    .animate-marquee-companies {
        animation: marquee 40s linear infinite;
    }
    /* Degradado que se desplaza despacio por el texto */
    @keyframes gradient-text {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }
    .animate-gradient-text {
        background-size: 200% auto;
        animation: gradient-text 6s ease-in-out infinite;
    }
    /* El saludo: la mano se mueve un par de veces al cargar */
    @keyframes wave {
        0%, 60%, 100% { transform: rotate(0deg); }
        10%, 30% { transform: rotate(14deg); }
        20% { transform: rotate(-8deg); }
        40% { transform: rotate(-4deg); }
