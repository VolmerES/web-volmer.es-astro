---
import { getLangFromUrl, useTranslations, useRoutes, brand } from '../../i18n/ui';
import { featuredProjects, clientLogos, techStack } from '../../data/projects';
import { services } from '../../data/services';
import ServiceCard from '../ServiceCard.astro';
import ProjectCard from '../ProjectCard.astro';
import ProcessSteps from '../ProcessSteps.astro';
import ReviewsCarousel from '../ReviewsCarousel.astro';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const r = useRoutes(lang);

const posts = (await getCollection('blog'))
    .filter((post) => post.id.startsWith(`${lang}/`))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const dateLocale = lang === 'es' ? 'es-ES' : 'en-GB';

const stats = [
    { value: '6+', label: t('home.stat1') },
    { value: '5,0★', label: t('home.stat2') },
    { value: '1:1', label: t('home.stat3') },
];
---

<main class="relative pt-28 md:pt-32 pb-12 md:pb-16">

    <!-- ============ HERO ============ -->
    <section class="max-w-7xl mx-auto px-6 pb-12 md:pb-16">
        <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-10 md:gap-16">

            <!-- Texto -->
            <div class="flex-1 flex flex-col items-start z-10 w-full">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-green-500/30 bg-green-500/10 text-green-400 text-[10px] font-bold tracking-wider mb-6">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                    {t('home.badge')}
                </div>

                <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] mb-6">
                    <span class="block text-gray-200">{t('home.title1')}</span>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-neon-pink">
                        {t('home.title2')}
                    </span>
                </h1>

                <p class="text-base md:text-lg text-gray-400 max-w-xl mb-8 leading-relaxed">
                    {t('home.subtitle')}
                </p>

                <div class="flex flex-wrap gap-3 mb-10">
                    <button class="open-quote-modal px-6 py-3 bg-neon-pink text-white text-sm font-bold rounded-lg hover:bg-pink-600 transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(255,42,109,0.4)] flex items-center gap-2">
                        {t('cta.quote')}
                    </button>
                    <a href={r.projects} class="px-6 py-3 bg-white/5 border border-white/15 text-white text-sm font-bold rounded-lg hover:bg-white/10 hover:border-neon-cyan/50 hover:text-neon-cyan transition-all flex items-center gap-2">
                        {t('cta.projects')}
                    </a>
                </div>

                <!-- Cifras de confianza -->
                <div class="grid grid-cols-3 gap-4 w-full max-w-lg border-t border-white/5 pt-6">
                    {stats.map(({ value, label }) => (
                        <div>
                            <p class="font-heading text-2xl md:text-3xl font-bold text-white mb-1">{value}</p>
                            <p class="text-[10px] md:text-xs text-gray-500 leading-tight">{label}</p>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Retrato -->
            <div class="flex-1 w-full max-w-sm relative">
                <div class="absolute -top-10 -right-10 w-72 h-72 bg-neon-cyan/10 rounded-full blur-[80px] -z-10 mix-blend-screen animate-pulse"></div>
                <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-neon-pink/10 rounded-full blur-[80px] -z-10 mix-blend-screen animate-pulse" style="animation-delay: 0.7s;"></div>

                <div class="relative flex flex-col items-center">
                    <div class="relative w-40 h-40 md:w-64 md:h-64 rounded-full p-1.5 border border-white/10 bg-[#050505]/80 backdrop-blur-2xl shadow-2xl group hover:border-white/30 transition-colors duration-500">
                        <img
                            src="/profile.png"
                            alt={brand.person}
                            width="256"
                            height="256"
                            class="w-full h-full object-cover rounded-full filter grayscale-[20%] contrast-[110%] group-hover:filter-none transition-all duration-500"
                        />
                        <div class="absolute inset-0 rounded-full border border-white/5 scale-110 pointer-events-none"></div>
                    </div>

                    <!-- Tarjeta de código estilo ventana de macOS -->
                    <div class="hidden md:block relative z-30 group/code bg-[#080808]/90 border border-white/10 rounded-xl p-3 md:p-5 font-mono text-[10px] md:text-xs leading-relaxed shadow-[0_10px_40px_rgba(0,0,0,0.5)] backdrop-blur-xl transform rotate-0 md:rotate-2 hover:rotate-0 transition-transform duration-300 max-w-[240px] md:max-w-[280px] mt-6 mx-auto">
                        <!-- Brillo de la tarjeta -->
                        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover/code:opacity-100 transition-opacity rounded-xl pointer-events-none"></div>

                        <div class="flex gap-1.5 mb-3">
                            <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-green-500/80"></div>
                        </div>
                        <div class="text-gray-400 font-medium">
                            <p><span class="text-purple-400">const</span> <span class="text-yellow-300">developer</span> = <span class="text-white">&lcub;</span></p>
                            <p class="pl-4">name: <span class="text-green-400">'Juan Delorme Pinedo'</span>,</p>
                            <p class="pl-4">alias: <span class="text-green-400">'Volmer'</span>,</p>
                            <p class="pl-4">role: <span class="text-green-400">'Software Engineer'</span>,</p>
                            <p class="pl-4">skills: [<span class="text-green-400">'Web'</span>, <span class="text-green-400">'Mobile'</span>, <span class="text-green-400">'AI'</span>],</p>
                            <p class="pl-4">likes: [<span class="text-green-400">'Drones'</span>, <span class="text-green-400">'Coffee'</span>]</p>
                            <p><span class="text-white">&rcub;;</span></p>
                        </div>
                        <div class="mt-4 flex gap-4 text-lg border-t border-white/5 pt-3 justify-end items-center opacity-60 group-hover/code:opacity-100 transition-opacity">
                            <a href={brand.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-400 hover:text-white transition-colors transform hover:scale-110">
                                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                            </a>
                            <a href={brand.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-400 hover:text-blue-500 transition-colors transform hover:scale-110">
                                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.063 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 22.227.792 23 1.771 23h20.451C23.2 23 24 22.227 24 21.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ LOGOS DE CLIENTES ============ -->
    <section class="max-w-7xl mx-auto px-6 py-10 border-t border-white/5">
        <p class="text-[10px] text-gray-500 uppercase tracking-widest mb-6 text-center">{t('home.trustCompanies')}</p>
        <div class="relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]">
            <div class="flex animate-marquee-companies whitespace-nowrap gap-12 w-max hover:[animation-play-state:paused]">
                {Array(2).fill(null).map(() => (
                    <div class="flex items-center gap-12 shrink-0">
                        {clientLogos.map((client) => (
                            <a href={client.url} target="_blank" rel="noopener noreferrer" aria-label={client.name}>
                                <img
                                    src={client.logo}
                                    alt={client.name}
                                    loading="lazy"
                                    class="h-8 md:h-10 w-auto object-contain opacity-40 grayscale hover:opacity-90 hover:grayscale-0 transition-all duration-300"
                                />
                            </a>
                        ))}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ============ SERVICIOS ============ -->
    <section class="max-w-7xl mx-auto px-6 py-12 md:py-16 border-t border-white/5">
        <div class="flex items-end justify-between mb-10 gap-4">
            <div>
                <span class="text-neon-cyan text-xs font-bold tracking-widest uppercase mb-2 block">{t('home.servicesTag')}</span>
                <h2 class="text-2xl md:text-4xl font-heading font-bold text-white">{t('home.servicesTitle')}</h2>
            </div>
            <a href={r.services} class="hidden sm:block text-xs font-bold text-gray-500 hover:text-white transition-colors shrink-0">
                {t('cta.services')} →
            </a>
        </div>

        <!--
          Las tarjetas de web y dron llevan su animación al hacer scroll: el
          portátil (Lottie) entra deslizándose y el dron llega volando y se
          queda flotando. Los ids los usa el script del final del fichero.
        -->
        <script src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.8.11/dist/dotlottie-wc.js" type="module" is:inline></script>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-16 md:pt-20">
            {services.map((service) => {
                const animated = service.id === 'web' || service.id === 'drone';
                if (!animated) return <ServiceCard service={service} />;

                return (
                    <div
                        id={service.id === 'web' ? 'web-card-container' : 'drone-card-container'}
                        class:list={["relative", service.id === 'web' ? "z-0" : "z-10"]}
                    >
                        {service.id === 'web' ? (
                            <div
                                id="scroll-laptop-container"
                                class="absolute pointer-events-none z-20 opacity-0 w-36 h-36 md:w-[220px] md:h-[220px] top-[-10%] md:top-[-20%]"
                                style="right: -5%; transform: translate(20%, 50%) rotate(10deg);"
                            >
                                <dotlottie-wc
                                    src="https://lottie.host/f649f0c3-81ba-4f5a-b773-462122464e3d/wpVpRTViVw.lottie"
                                    autoplay
                                    loop
                                    style="width: 100%; height: 100%;"
                                ></dotlottie-wc>
                            </div>
                        ) : (
                            <img
                                id="scroll-drone"
                                src="/drone.png"
                                alt=""
                                aria-hidden="true"
                                class="absolute pointer-events-none z-20 w-28 md:w-48 opacity-0 top-[-2%] md:top-[-5%]"
                                style="right: -5%; transform: translate(20%, 50%) rotate(-15deg) scale(0.5);"
                            />
                        )}
                        <ServiceCard service={service} />
                    </div>
                );
            })}
        </div>

        <div class="mt-8 text-center sm:hidden">
            <a href={r.services} class="text-sm font-bold text-gray-400 hover:text-white transition-colors">
                {t('cta.services')} →
            </a>
        </div>
    </section>

    <!-- ============ PROYECTOS DESTACADOS ============ -->
    <section class="max-w-7xl mx-auto px-6 py-12 md:py-16 border-t border-white/5">
        <div class="flex items-end justify-between mb-10 gap-4">
            <div>
                <span class="text-neon-pink text-xs font-bold tracking-widest uppercase mb-2 block">{t('home.projectsTag')}</span>
                <h2 class="text-2xl md:text-4xl font-heading font-bold text-white">{t('home.projectsTitle')}</h2>
            </div>
            <a href={r.projects} class="hidden sm:block text-xs font-bold text-gray-500 hover:text-white transition-colors shrink-0">
                {t('cta.all')} →
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>

        <div class="mt-8 text-center sm:hidden">
            <a href={r.projects} class="text-sm font-bold text-gray-400 hover:text-white transition-colors">
                {t('cta.all')} →
            </a>
        </div>
    </section>

    <!-- ============ RESEÑAS ============ -->
    <ReviewsCarousel />

    <!-- ============ PROCESO ============ -->
    <section class="max-w-7xl mx-auto px-6 py-12 md:py-16 border-t border-white/5">
        <div class="text-center mb-12">
            <span class="text-neon-cyan text-xs font-bold tracking-widest uppercase mb-2 block">{t('home.processTag')}</span>
            <h2 class="text-2xl md:text-4xl font-heading font-bold text-white">{t('home.processTitle')}</h2>
        </div>
        <ProcessSteps />
    </section>

    <!-- ============ TECNOLOGÍAS ============ -->
    <section class="max-w-7xl mx-auto px-6 py-10 border-t border-white/5 overflow-hidden">
        <p class="text-[10px] text-gray-500 uppercase tracking-widest mb-5 text-center">{t('home.trustTech')}</p>
        <div class="relative w-full [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
            <div class="flex animate-marquee whitespace-nowrap gap-8 w-max hover:[animation-play-state:paused]">
                {Array(2).fill(null).map(() => (
                    <div class="flex gap-8 opacity-80 grayscale hover:grayscale-0 transition-all duration-500 text-sm shrink-0">
                        {techStack.map((tech) => (
                            <span class="font-bold cursor-default" style={`color: ${tech.color}`}>{tech.name}</span>
                        ))}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ============ BLOG ============ -->
    <section class="max-w-7xl mx-auto px-6 py-12 md:py-16 border-t border-white/5">
        <div class="flex items-end justify-between mb-10 gap-4">
            <div>
                <span class="text-neon-cyan text-xs font-bold tracking-widest uppercase mb-2 block">{t('home.blogTag')}</span>
                <h2 class="text-2xl md:text-4xl font-heading font-bold text-white">{t('home.blogTitle')}</h2>
            </div>
            {posts.length > 0 && (
                <a href={r.blog} class="hidden sm:block text-xs font-bold text-gray-500 hover:text-white transition-colors shrink-0">
                    {t('cta.all')} →
                </a>
            )}
        </div>

        {posts.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-white/10 bg-white/[0.02] px-6 py-12 text-center">
                <p class="text-gray-500 text-sm">{t('home.blogEmpty')}</p>
            </div>
        ) : (
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                {posts.map((post) => (
                    <article class="group relative flex flex-col h-full rounded-xl overflow-hidden bg-[#111] border border-white/10 hover:border-neon-cyan/50 transition-all duration-300">
                        <a href={`${r.blog}/${post.slug.replace(/^(es|en)\//, '')}/`} class="flex flex-col h-full">
                            <div class="h-36 bg-gray-900 relative overflow-hidden shrink-0">
                                {post.data.heroImage && (
                                    <div
                                        class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
                                        style={`background-image: url('${post.data.heroImage}');`}
                                    ></div>
                                )}
                                <div class="absolute inset-0 bg-gradient-to-t from-[#111] to-transparent"></div>
                                <span class="absolute top-3 left-3 px-2 py-1 text-[10px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md border border-white/10 rounded text-white">
                                    {post.data.pubDate.toLocaleDateString(dateLocale, { month: 'short', day: 'numeric' })}
                                </span>
                            </div>
                            <div class="p-5 flex flex-col flex-grow">
                                <h3 class="text-lg font-bold font-heading mb-2 leading-tight group-hover:text-neon-cyan transition-colors line-clamp-2">
                                    {post.data.title}
                                </h3>
                                <p class="text-xs text-gray-500 line-clamp-2 mb-4">{post.data.description}</p>
                                <span class="text-neon-cyan text-xs font-bold flex items-center gap-1 mt-auto">
                                    {t('cta.readMore')} <span class="group-hover:translate-x-1 transition-transform">→</span>
                                </span>
                            </div>
                        </a>
                    </article>
                ))}
            </div>
        )}
    </section>

    <!-- ============ CTA FINAL ============ -->
    <section class="max-w-5xl mx-auto px-6 py-12 md:py-16">
        <div class="relative text-center py-14 md:py-20 px-6 bg-gradient-to-tr from-white/5 to-transparent rounded-3xl border border-white/10 overflow-hidden">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-neon-cyan/10 rounded-full blur-[100px] -z-10"></div>

            <h2 class="text-3xl md:text-5xl font-heading font-bold mb-5 text-white">{t('home.finalTitle')}</h2>
            <p class="text-base md:text-lg text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed">{t('home.finalSubtitle')}</p>

            <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
                <button class="open-quote-modal w-full sm:w-auto px-8 py-4 text-base font-bold text-dark-bg bg-neon-cyan hover:bg-white transition-all rounded-full shadow-[0_0_20px_rgba(5,217,232,0.4)]">
                    {t('cta.quote')}
                </button>
                <a href={r.contact} class="w-full sm:w-auto px-8 py-4 text-base font-bold text-white bg-white/5 border border-white/15 hover:bg-white/10 hover:border-white/30 transition-all rounded-full">
                    {t('cta.contact')}
                </a>
            </div>
        </div>
    </section>
</main>

<script>
    /**
     * Animaciones al hacer scroll de las tarjetas de servicio.
     *
     * El dron entra volando desde la derecha, frena inclinándose y se queda
     * flotando con dos senos superpuestos para que el vaivén no parezca
     * mecánico. El portátil (Lottie) entra deslizándose en lateral.
     *
     * Ambas se saltan si el usuario pide movimiento reducido.
     */
    const prefersReducedMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** Ejecuta handleScroll como mucho una vez por frame. */
    const onScrollThrottled = (handleScroll: () => void) => {
        let ticking = false;
        return () => {
            if (ticking) return;
            window.requestAnimationFrame(() => {
                handleScroll();
                ticking = false;
            });
            ticking = true;
        };
    };

    const initDroneAnimation = () => {
        const drone = document.getElementById('scroll-drone');
        const droneCard = document.getElementById('drone-card-container');
        if (!drone || !droneCard) return;

        if (prefersReducedMotion()) {
            drone.style.opacity = '1';
            drone.style.transform = 'translate(0%, 10%) rotate(5deg) scale(1.4)';
            return;
        }

        let isHovering = false;
        let hoverLoopId: number | null = null;

        // Flotación continua una vez ha aterrizado.
        const animateHover = () => {
            if (!isHovering) return;
            const time = Date.now() / 1000;
            const floatY = Math.sin(time) * 4 + Math.sin(time * 2.5) * 1.5;
            const floatRot = Math.cos(time * 0.8) * 2.5;
            drone.style.transform = `translate(0%, ${10 + floatY}%) rotate(${5 + floatRot}deg) scale(1.4)`;
            hoverLoopId = requestAnimationFrame(animateHover);
        };

        const handleScroll = () => {
            const rect = droneCard.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const scrollStart = windowHeight * 0.95;
            const scrollEnd = windowHeight * 0.6;
            const scrollProgress = Math.max(0, Math.min(1, (scrollStart - rect.top) / (scrollStart - scrollEnd)));

            if (scrollProgress > 0 && scrollProgress < 1) {
                // En vuelo: la posición la manda el scroll, no un temporizador.
                isHovering = false;
                if (hoverLoopId) cancelAnimationFrame(hoverLoopId);

                const easeProgress = 1 - Math.pow(1 - scrollProgress, 3);
                const translateX = 200 - easeProgress * 200;
                const translateY = 50 - easeProgress * 40;
                // Se inclina al entrar en la curva y se nivela al final.
                const rotate = easeProgress < 0.8 ? 20 - easeProgress * 15 : 5;
                const scale = 0.5 + easeProgress * 0.9;

                drone.style.transform = `translate(${translateX}%, ${translateY}%) rotate(${rotate}deg) scale(${scale})`;
                drone.style.opacity = easeProgress.toString();
            } else if (scrollProgress >= 1) {
                drone.style.opacity = '1';
                if (!isHovering) {
                    isHovering = true;
                    animateHover();
                }
            } else {
                isHovering = false;
                if (hoverLoopId) cancelAnimationFrame(hoverLoopId);
                drone.style.opacity = '0';
                drone.style.transform = 'translate(200%, 50%) rotate(20deg) scale(0.5)';
            }
        };

        window.addEventListener('scroll', onScrollThrottled(handleScroll));
        handleScroll();
    };

    const initLaptopAnimation = () => {
        const laptop = document.getElementById('scroll-laptop-container');
        const laptopCard = document.getElementById('web-card-container');
        if (!laptop || !laptopCard) return;

        if (prefersReducedMotion()) {
            laptop.style.opacity = '1';
            laptop.style.transform = 'translate(0%, -10%) rotate(5deg)';
            return;
        }

        const handleScroll = () => {
            const rect = laptopCard.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const scrollStart = windowHeight * 0.95;
            const scrollEnd = windowHeight * 0.6;
            const scrollProgress = Math.max(0, Math.min(1, (scrollStart - rect.top) / (scrollStart - scrollEnd)));

            if (scrollProgress > 0 && scrollProgress <= 1) {
                const easeProgress = 1 - Math.pow(1 - scrollProgress, 3);
                // Entra en lateral desde detrás de la tarjeta del dron.
                const translateX = 150 - easeProgress * 150;
                // La escala se queda en 1 para que el Lottie no se pixele.
                laptop.style.transform = `translate(${translateX}%, -10%) rotate(5deg) scale(1)`;
                laptop.style.opacity = easeProgress.toString();
            } else if (scrollProgress > 1) {
                laptop.style.opacity = '1';
                const floatY = Math.sin(Date.now() / 1000) * 3;
                laptop.style.transform = `translate(0%, ${-10 + floatY}%) rotate(5deg) scale(1)`;
            } else {
                laptop.style.opacity = '0';
                laptop.style.transform = 'translate(150%, -10%) rotate(5deg) scale(1)';
            }
        };

        window.addEventListener('scroll', onScrollThrottled(handleScroll));
        handleScroll();
    };

    document.addEventListener('astro:page-load', () => {
        initDroneAnimation();
        initLaptopAnimation();
    });
</script>

<style>
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .animate-marquee {
        animation: marquee 30s linear infinite;
    }
    .animate-marquee-companies {
        animation: marquee 40s linear infinite;
    }
    @media (prefers-reduced-motion: reduce) {
        .animate-marquee,
        .animate-marquee-companies {
            animation: none;
        }
    }
</style>
