---
import { getLangFromUrl, useTranslations, useRoutes, brand, blogVisible } from '../../i18n/ui';
import { featuredProjects, clientLogos } from '../../data/projects';
import { services } from '../../data/services';
import ServiceCard from '../ServiceCard.astro';
import ProjectCard from '../ProjectCard.astro';
import ProcessSteps from '../ProcessSteps.astro';
import ReviewsCarousel from '../ReviewsCarousel.astro';
import reviews from '../../../Reviews.json';
import { getCollection } from 'astro:content';
import NewsCard from '../NewsCard.astro';
import { getNews } from '../../lib/news';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const r = useRoutes(lang);

const posts = (await getCollection('blog'))
    .filter((post) => post.id.startsWith(`${lang}/`))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const dateLocale = lang === 'es' ? 'es-ES' : 'en-GB';

const rating = (reviews.reduce((sum, r) => sum + r.stars, 0) / reviews.length)
    .toLocaleString(lang === 'es' ? 'es-ES' : 'en-GB', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const reviewCount = t('home.stat2').replace('{n}', String(reviews.length));
// Iniciales de las últimas reseñas, para la fila de caras junto a la nota.
const reviewFaces = reviews.slice(0, 4).map((review) =>
    review.name.split(' ').map((n) => n[0]).slice(0, 2).join('').toUpperCase());
const faceColors = ['from-blue-500 to-purple-600', 'from-green-500 to-teal-600', 'from-pink-500 to-red-500', 'from-yellow-500 to-orange-500'];

/**
 * Quién soy, en tarjetas. Las clases van enteras y no montadas con el color,
 * porque Tailwind solo genera las que encuentra escritas tal cual.
 */
const credentials = [
    {
        key: '42',
        // Sin JavaScript lleva a la clasificación oficial; con él abre la
        // captura en grande (#wuri-modal).
        href: brand.wuriRanking,
        card: 'hover:border-neon-cyan/50',
        box: 'bg-neon-cyan/15 text-neon-cyan group-hover/card:bg-neon-cyan group-hover/card:text-black',
        title: 'group-hover/card:text-neon-cyan',
        icon: null,
    },
    {
        key: 'studio',
        href: r.services,
        card: 'hover:border-neon-pink/50',
        box: 'bg-neon-pink/15 text-neon-pink group-hover/card:bg-neon-pink group-hover/card:text-white',
        title: 'group-hover/card:text-neon-pink',
        icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    },
    {
        key: 'play',
        href: r.swipeApp,
        card: 'hover:border-emerald-400/50',
        box: 'bg-emerald-400/15 text-emerald-400 group-hover/card:bg-emerald-400 group-hover/card:text-black',
        title: 'group-hover/card:text-emerald-400',
        icon: 'M5 4.5v15a1 1 0 001.5.87l13-7.5a1 1 0 000-1.74l-13-7.5A1 1 0 005 4.5z',
    },
    {
        key: 'embedded',
        href: null,
        card: 'hover:border-violet-400/50',
        box: 'bg-violet-400/15 text-violet-400 group-hover/card:bg-violet-400 group-hover/card:text-black',
        title: 'group-hover/card:text-violet-400',
        icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
    },
    {
        key: 'drone',
        href: `${r.services}#drone`,
        card: 'hover:border-yellow-400/50',
        box: 'bg-yellow-400/15 text-yellow-400 group-hover/card:bg-yellow-400 group-hover/card:text-black',
        title: 'group-hover/card:text-yellow-400',
        icon: 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8',
    },
] as const;

// Manifiesto: cada palabra se enciende por separado al hacer scroll.
const manifestoWords = `${t('home.manifesto1')} ${t('home.manifesto2')}`.split(' ');
const manifestoTyped = t('home.manifestoTyped');
const principles = t('home.principles').split('|');

const news = (await getNews(lang)).slice(0, 3);
---

<!-- overflow-x-clip: el dron y el portátil esperan fuera de pantalla antes de entrar volando -->
<main class="relative pt-28 md:pt-32 pb-12 md:pb-16 overflow-x-clip">

    <!-- ============ HERO ============ -->
    <section class="relative max-w-7xl mx-auto px-6 pb-12 md:pb-16">
        <!-- Marcas de fondo a distintas velocidades: dan profundidad al hacer scroll -->
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
            <div data-parallax="0.35" data-parallax-from="top" class="absolute top-[4%] right-[30%] hidden md:block w-28 h-28 rounded-full border border-neon-cyan/15"></div>
            <div data-parallax="0.55" data-parallax-from="top" class="absolute top-[12%] right-[6%] font-mono text-2xl text-neon-pink/40">+</div>
            <div data-parallax="0.2" data-parallax-from="top" class="absolute top-[58%] left-[44%] hidden md:block font-mono text-xl text-neon-cyan/30">+</div>
            <div data-parallax="0.15" data-parallax-from="top" class="absolute -bottom-6 -left-4 w-36 h-36 opacity-60 [background-image:radial-gradient(rgba(255,255,255,0.18)_1px,transparent_1px)] [background-size:14px_14px] [mask-image:radial-gradient(circle,black_30%,transparent_70%)]"></div>
        </div>
        <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-10 md:gap-16">

            <!-- Texto -->
            <div class="flex-1 flex flex-col items-start z-10 w-full">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-green-500/30 bg-green-500/10 text-green-400 text-[10px] font-bold tracking-wider mb-6">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                    {t('home.badge')}
                </div>

                <p class="font-heading text-xl md:text-2xl text-gray-300 mb-3">
                    {t('home.hello')} <span class="inline-block origin-[70%_70%] animate-wave">👋</span>
                </p>

                <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight mb-6">
                    <span class="block text-gray-100">{t('home.title1')}</span>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-purple-400 to-neon-pink animate-gradient-text">
                        {t('home.title2')}
                    </span>
                </h1>

                <p class="text-base md:text-lg text-gray-400 max-w-xl mb-8 leading-relaxed">
                    {t('home.subtitle')}
                </p>

                <div class="flex flex-wrap gap-3 mb-8">
                    <button class="open-quote-modal px-6 py-3 bg-neon-pink text-white text-sm font-bold rounded-lg hover:bg-pink-600 transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(255,42,109,0.4)] flex items-center gap-2">
                        {t('cta.quote')}
                    </button>
                    <a href={`https://wa.me/${brand.whatsapp}`} target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white/5 border border-white/15 text-white text-sm font-bold rounded-lg hover:bg-[#25D366]/10 hover:border-[#25D366]/60 hover:text-[#25D366] transition-all flex items-center gap-2">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                        {t('home.whatsapp')}
                    </a>
                </div>

                <!-- Nota de Google: caras de quien ha opinado y la media -->
                <a href={brand.maps} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3">
                    <div class="flex -space-x-1.5">
                        {reviewFaces.map((initials, i) => (
                            <span class={`w-8 h-8 rounded-full bg-gradient-to-br ${faceColors[i]} ring-2 ring-dark-bg flex items-center justify-center text-[10px] font-bold text-white transition-transform group-hover:-translate-y-0.5`} style={`transition-delay: ${i * 40}ms`}>
                                {initials}
                            </span>
                        ))}
                    </div>
                    <div class="leading-tight">
                        <p class="text-sm text-white font-bold"><span class="text-yellow-400">★★★★★</span> {rating}</p>
                        <p class="text-xs text-gray-500 group-hover:text-neon-cyan transition-colors">{reviewCount} ↗</p>
                    </div>
                </a>
            </div>

            <!-- Retrato -->
            <div class="flex-1 w-full max-w-sm relative">
                <div data-parallax="0.3" data-parallax-from="top" class="absolute -top-10 -right-10 w-72 h-72 bg-neon-cyan/10 rounded-full blur-[80px] -z-10 mix-blend-screen animate-pulse"></div>
                <div data-parallax="0.18" data-parallax-from="top" class="absolute -bottom-10 -left-10 w-72 h-72 bg-neon-pink/10 rounded-full blur-[80px] -z-10 mix-blend-screen animate-pulse" style="animation-delay: 0.7s;"></div>

                <div class="relative flex flex-col items-center">
                    <div data-parallax="0.12" data-parallax-from="top" class="relative w-40 h-40 md:w-64 md:h-64 rounded-full p-1.5 border border-white/10 bg-[#050505]/80 backdrop-blur-2xl shadow-2xl group hover:border-white/30 transition-colors duration-500">
                        <img
                            src="/profile.png"
                            alt={brand.person}
                            width="256"
                            height="256"
                            class="w-full h-full object-cover rounded-full filter grayscale-[20%] contrast-[110%] group-hover:filter-none transition-all duration-500"
                        />
                        <div class="absolute inset-0 rounded-full border border-white/5 scale-110 pointer-events-none"></div>
                    </div>

                    <!-- Tarjeta de código estilo ventana de macOS -->
                    <div data-parallax="-0.06" data-parallax-from="top" class="hidden md:block relative z-30 group/code bg-[#080808]/90 border border-white/10 rounded-xl p-3 md:p-5 font-mono text-[10px] md:text-xs leading-relaxed shadow-[0_10px_40px_rgba(0,0,0,0.5)] backdrop-blur-xl transform rotate-0 md:rotate-2 hover:rotate-0 transition-transform duration-300 max-w-[260px] md:max-w-[340px] mt-6 mx-auto">
                        <!-- Brillo de la tarjeta -->
                        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover/code:opacity-100 transition-opacity rounded-xl pointer-events-none"></div>

                        <div class="flex gap-1.5 mb-3">
                            <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-green-500/80"></div>
                        </div>
                        <div class="text-gray-400 font-medium">
                            <p><span class="text-purple-400">const</span> <span class="text-yellow-300">developer</span> = <span class="text-white">&lcub;</span></p>
                            <p class="pl-4">name: <span class="text-green-400">'Juan Bautista Delorme Pinedo'</span>,</p>
                            <p class="pl-4">alias: <span class="text-green-400">'Volmer'</span>,</p>
                            <p class="pl-4">role: <span class="text-green-400">'Software Developer'</span>,</p>
                            <p class="pl-4">skills: [<span class="text-green-400">'Web'</span>, <span class="text-green-400">'Apps'</span>, <span class="text-green-400">'Embedded'</span>],</p>
                            <p class="pl-4">likes: [<span class="text-green-400">'Drones'</span>, <span class="text-green-400">'Coffee'</span>]</p>
                            <p><span class="text-white">&rcub;;</span></p>
                        </div>
                        <div class="mt-4 flex gap-4 text-lg border-t border-white/5 pt-3 justify-end items-center opacity-60 group-hover/code:opacity-100 transition-opacity">
                            <a href={brand.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-400 hover:text-white transition-colors transform hover:scale-110">
                                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                            </a>
                            <a href={brand.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-400 hover:text-blue-500 transition-colors transform hover:scale-110">
                                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.063 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 22.227.792 23 1.771 23h20.451C23.2 23 24 22.227 24 21.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quién soy: credenciales -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mt-12 md:mt-16">
            {credentials.map((cred) => {
                const Tag = cred.href ? 'a' : 'div';
                const external = cred.href?.startsWith('http');
                return (
                    <Tag
                        href={cred.href ?? undefined}
                        data-wuri={cred.key === '42' ? '' : undefined}
                        target={external ? '_blank' : undefined}
                        rel={external ? 'noopener noreferrer' : undefined}
                        class:list={[
                            "p-4 md:p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md transition-all duration-300 group/card hover:-translate-y-1",
                            cred.card,
                            cred.key === 'drone' && "col-span-2 md:col-span-1",
                        ]}
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <span class:list={["w-8 h-8 shrink-0 rounded-lg flex items-center justify-center transition-all duration-300", cred.box]}>
                                {cred.icon ? (
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d={cred.icon} />
                                    </svg>
                                ) : (
                                    <span class="font-heading font-black text-sm leading-none">42</span>
                                )}
                            </span>
                            <p class:list={["font-heading font-bold text-white text-sm md:text-base leading-tight transition-colors", cred.title]}>
                                {t(`home.cred.${cred.key}.title`)}
                            </p>
                        </div>
                        <p class="text-xs text-gray-400 leading-snug">{t(`home.cred.${cred.key}.desc`)}</p>
                        {cred.key === '42' && (
                            <p class="mt-2 text-[11px] font-bold text-neon-cyan/80 group-hover/card:text-neon-cyan transition-colors">
                                {t('home.cred.42.more')} →
                            </p>
                        )}
                    </Tag>
                );
            })}
        </div>
    </section>

    <!-- La clasificación WURI en grande, al pulsar la tarjeta de 42 -->
    <dialog
        id="wuri-modal"
        aria-labelledby="wuri-title"
        class="bg-transparent p-0 m-auto w-[min(92vw,960px)] max-h-[90vh] backdrop:bg-black/80 backdrop:backdrop-blur-sm"
    >
        <div class="relative bg-[#121212] border border-white/10 rounded-2xl p-5 md:p-7 shadow-2xl">
            <button type="button" data-wuri-close aria-label={t('home.close')} class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:border-white/30 transition-colors flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <h3 id="wuri-title" class="font-heading font-bold text-xl md:text-2xl text-white pr-10 mb-4">{t('home.wuriTitle')}</h3>
            <a href={brand.wuriPdf} target="_blank" rel="noopener noreferrer" class="block rounded-lg overflow-hidden border border-white/10 hover:border-neon-cyan/50 transition-colors">
                <!-- En móvil, solo la columna de los puestos 1-12: la tabla entera no se lee -->
                <picture>
                    <source media="(max-width: 640px)" srcset="/wuri-2026-movil.webp" width="1034" height="725" />
                    <img src="/wuri-2026.webp" width="1786" height="728" loading="lazy" alt="WURI 2026: Global Top 500 Innovative Universities. 1 Minerva University, 2 Arizona State University, 3 École 42, 4 University of Pennsylvania, 5 MIT, 7 Stanford, 12 Harvard." class="w-full h-auto bg-white" />
                </picture>
            </a>
            <p class="text-xs md:text-sm text-gray-400 leading-relaxed mt-4">{t('home.wuriCaption')}</p>
            <div class="flex flex-wrap gap-3 mt-5">
                <a href={brand.wuriRanking} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 text-sm font-bold text-dark-bg bg-neon-cyan hover:bg-white transition-all rounded-full">
                    {t('home.wuriLink')} ↗
                </a>
                <a href={brand.wuriPdf} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 text-sm font-bold text-white bg-white/5 border border-white/15 hover:border-white/30 transition-all rounded-full">
                    {t('home.wuriPdf')} ↗
                </a>
            </div>
        </div>
    </dialog>

    <!-- ============ LOGOS DE CLIENTES ============ -->
    <section class="max-w-7xl mx-auto px-6 py-10 border-t border-white/5">
        <p data-reveal class="text-xs text-gray-400 uppercase tracking-widest mb-6 text-center">{t('home.trustCompanies')}</p>
        <div data-reveal class="relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]">
            <div class="flex animate-marquee-companies whitespace-nowrap gap-12 w-max hover:[animation-play-state:paused]">
                {Array(2).fill(null).map(() => (
                    <div class="flex items-center gap-12 shrink-0">
                        {clientLogos.map((client) => (
                            <a href={client.url} target="_blank" rel="noopener noreferrer" aria-label={client.name}>
                                <img
                                    src={client.logo}
                                    alt={client.name}
                                    width={client.w}
                                    height={client.h}
                                    loading="lazy"
                                    class:list={["h-8 md:h-10 w-auto object-contain opacity-85 hover:opacity-100 hover:scale-105 transition-all duration-300", client.tone]}
                                />
                            </a>
                        ))}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ============ RESEÑAS ============ -->
    <ReviewsCarousel />

    <!-- ============ MANIFIESTO ============ -->
    <!--
      Se queda fijo mientras bajas: las palabras se encienden una a una,
      «plantilla» se tacha y debajo se escribe la alternativa. Lo mueve todo la
      variable --p (de 0 a 1) que calcula src/scripts/motion.ts; sin JavaScript
      o con «reducir movimiento» vale 1 y se ve directamente el estado final.
    -->
    <section data-scroll-p="pin" class="manifesto relative border-t border-white/5">
        <div class="manifesto-frame relative flex items-center overflow-clip py-16 md:py-24">
            <div aria-hidden="true" class="manifesto-glow absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(255,42,109,0.13),transparent_65%)]"></div>
            <div class="max-w-5xl mx-auto px-6 w-full">
                <p class="font-mono text-xs md:text-sm text-neon-pink/80 mb-6 md:mb-8">{t('home.manifestoTag')}</p>
                <h2 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.08] tracking-tight text-gray-100">
                    {manifestoWords.map((word, i) => (
                        <><span class="manifesto-word" style={`--at: ${(0.02 + i * 0.032).toFixed(3)}`}>{word}</span>{' '}</>
                    ))}
                    <span class="whitespace-nowrap"><span class="manifesto-word relative inline-block" style={`--at: ${(0.02 + manifestoWords.length * 0.032).toFixed(3)}`}>
                        <span class="manifesto-struck">{t('home.manifestoStrike')}</span>
                        <svg aria-hidden="true" class="manifesto-strike absolute left-[-3%] top-[56%] w-[106%] h-[0.4em] -translate-y-1/2 overflow-visible" viewBox="0 0 100 10" preserveAspectRatio="none">
                            <path d="M1 6.2 C 16 3.8, 34 7.6, 51 5.2 S 83 3.4, 99 5.4" pathLength="1" />
                        </svg>
                    </span>.</span>
                </h2>

                <p class="manifesto-typed mt-5 md:mt-7 font-mono text-lg sm:text-xl md:text-3xl font-medium" style={`--chars: ${manifestoTyped.length}`}>
                    <span aria-hidden="true" class="text-neon-cyan">&gt;</span>
