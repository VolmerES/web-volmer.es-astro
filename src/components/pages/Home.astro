<script>
    /**
     * Animaciones al hacer scroll de las tarjetas de servicio.
     *
     * El dron entra volando desde la derecha, frena inclinándose y se queda
     * flotando con dos senos superpuestos para que el vaivén no parezca
     * mecánico. El portátil (Lottie) entra deslizándose en lateral.
     *
     * Ambas se saltan si el usuario pide movimiento reducido.
     */
    const prefersReducedMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** Ejecuta handleScroll como mucho una vez por frame. */
    const onScrollThrottled = (handleScroll: () => void) => {
        let ticking = false;
        return () => {
            if (ticking) return;
            window.requestAnimationFrame(() => {
                handleScroll();
                ticking = false;
            });
            ticking = true;
        };
    };

    const initDroneAnimation = () => {
        const drone = document.getElementById('scroll-drone');
        const droneCard = document.getElementById('drone-card-container');
        if (!drone || !droneCard) return;

        if (prefersReducedMotion()) {
            drone.style.opacity = '1';
            drone.style.transform = 'translate(0%, 10%) rotate(5deg) scale(1.4)';
            return;
        }

        let isHovering = false;
        let hoverLoopId: number | null = null;

        // Flotación continua una vez ha aterrizado.
        const animateHover = () => {
            if (!isHovering) return;
            const time = Date.now() / 1000;
            const floatY = Math.sin(time) * 4 + Math.sin(time * 2.5) * 1.5;
            const floatRot = Math.cos(time * 0.8) * 2.5;
            drone.style.transform = `translate(0%, ${10 + floatY}%) rotate(${5 + floatRot}deg) scale(1.4)`;
            hoverLoopId = requestAnimationFrame(animateHover);
        };

        const handleScroll = () => {
            const rect = droneCard.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const scrollStart = windowHeight * 0.95;
            const scrollEnd = windowHeight * 0.6;
            const scrollProgress = Math.max(0, Math.min(1, (scrollStart - rect.top) / (scrollStart - scrollEnd)));

            if (scrollProgress > 0 && scrollProgress < 1) {
                // En vuelo: la posición la manda el scroll, no un temporizador.
                isHovering = false;
                if (hoverLoopId) cancelAnimationFrame(hoverLoopId);

                const easeProgress = 1 - Math.pow(1 - scrollProgress, 3);
                const translateX = 200 - easeProgress * 200;
                const translateY = 50 - easeProgress * 40;
                // Se inclina al entrar en la curva y se nivela al final.
                const rotate = easeProgress < 0.8 ? 20 - easeProgress * 15 : 5;
                const scale = 0.5 + easeProgress * 0.9;

                drone.style.transform = `translate(${translateX}%, ${translateY}%) rotate(${rotate}deg) scale(${scale})`;
                drone.style.opacity = easeProgress.toString();
            } else if (scrollProgress >= 1) {
                drone.style.opacity = '1';
                if (!isHovering) {
                    isHovering = true;
                    animateHover();
                }
            } else {
                isHovering = false;
                if (hoverLoopId) cancelAnimationFrame(hoverLoopId);
                drone.style.opacity = '0';
                drone.style.transform = 'translate(200%, 50%) rotate(20deg) scale(0.5)';
            }
        };

        window.addEventListener('scroll', onScrollThrottled(handleScroll));
        handleScroll();
    };

    const initLaptopAnimation = () => {
        const laptop = document.getElementById('scroll-laptop-container');
        const laptopCard = document.getElementById('web-card-container');
        if (!laptop || !laptopCard) return;

        if (prefersReducedMotion()) {
            laptop.style.opacity = '1';
            laptop.style.transform = 'translate(0%, -10%) rotate(5deg)';
            return;
        }

        const handleScroll = () => {
            const rect = laptopCard.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const scrollStart = windowHeight * 0.95;
            const scrollEnd = windowHeight * 0.6;
            const scrollProgress = Math.max(0, Math.min(1, (scrollStart - rect.top) / (scrollStart - scrollEnd)));

            if (scrollProgress > 0 && scrollProgress <= 1) {
                const easeProgress = 1 - Math.pow(1 - scrollProgress, 3);
                // Entra en lateral desde detrás de la tarjeta del dron.
                const translateX = 150 - easeProgress * 150;
                // La escala se queda en 1 para que el Lottie no se pixele.
                laptop.style.transform = `translate(${translateX}%, -10%) rotate(5deg) scale(1)`;
                laptop.style.opacity = easeProgress.toString();
            } else if (scrollProgress > 1) {
                laptop.style.opacity = '1';
                const floatY = Math.sin(Date.now() / 1000) * 3;
                laptop.style.transform = `translate(0%, ${-10 + floatY}%) rotate(5deg) scale(1)`;
            } else {
                laptop.style.opacity = '0';
                laptop.style.transform = 'translate(150%, -10%) rotate(5deg) scale(1)';
            }
        };

        window.addEventListener('scroll', onScrollThrottled(handleScroll));
        handleScroll();
    };

    document.addEventListener('astro:page-load', () => {
        initDroneAnimation();
        initLaptopAnimation();
    });
</script>

<script>
    // Tarjeta de 42: abre la captura del ranking en vez de salir de la web.
    document.addEventListener('astro:page-load', () => {
        const modal = document.getElementById('wuri-modal') as HTMLDialogElement | null;
        if (!modal) return;
        document.querySelectorAll<HTMLElement>('[data-wuri]').forEach((card) => {
            card.addEventListener('click', (e) => {
                e.preventDefault();
                modal.showModal();
            });
        });
        modal.querySelector('[data-wuri-close]')?.addEventListener('click', () => modal.close());
        // Pulsar fuera de la tarjeta (en el fondo) también cierra.
        modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.close();
        });
    });
</script>

<script>
    import { sendLead, LeadRejected } from '../../lib/leads';

    document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('home-contact-form') as HTMLFormElement | null;
        const button = document.getElementById('hc-submit') as HTMLButtonElement | null;
        if (!form || !button) return;

        const labels = button.dataset;
        const reset = (delay: number) => setTimeout(() => {
            button.innerText = labels.labelIdle || '';
            button.classList.remove('!bg-none', '!bg-emerald-500', '!bg-red-500');
            button.disabled = false;
        }, delay);

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            button.disabled = true;
            button.innerText = labels.labelSending || '';
            try {
                await sendLead({
                    source: 'contact',
                    email: (document.getElementById('hc-email') as HTMLInputElement).value,
                    subject: form.dataset.subject,
                    message: (document.getElementById('hc-message') as HTMLTextAreaElement).value,
                    website: (document.getElementById('hc-website') as HTMLInputElement | null)?.value,
                }, { panel: form.dataset.panel || '', formspree: form.dataset.formspree || '' });
                button.innerText = labels.labelSent || '';
                button.classList.add('!bg-none', '!bg-emerald-500');
                form.reset();
                reset(2500);
            } catch (error) {
                console.error(error);
                button.innerText = error instanceof LeadRejected ? error.message : (labels.labelError || '');
                button.classList.add('!bg-none', '!bg-red-500');
                reset(3500);
            }
        });
    });
</script>

<style>
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .animate-marquee {
        animation: marquee 30s linear infinite;
    }
    .animate-marquee-companies {
        animation: marquee 40s linear infinite;
    }
    /* Cintas del manifiesto */
    .animate-ribbon {
        animation: marquee 45s linear infinite;
    }
    /* Degradado que se desplaza despacio por el texto */
    @keyframes gradient-text {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }
    .animate-gradient-text {
        background-size: 200% auto;
        animation: gradient-text 6s ease-in-out infinite;
    }
    /* El saludo: la mano se mueve un par de veces al cargar */
    @keyframes wave {
        0%, 60%, 100% { transform: rotate(0deg); }
        10%, 30% { transform: rotate(14deg); }
        20% { transform: rotate(-8deg); }
        40% { transform: rotate(-4deg); }
        50% { transform: rotate(10deg); }
    }
    .animate-wave {
        animation: wave 2.4s ease-in-out 0.6s 2;
    }
    @media (prefers-reduced-motion: reduce) {
        .animate-marquee,
        .animate-marquee-companies,
        .animate-ribbon,
        .animate-gradient-text,
        .animate-wave {
            animation: none;
        }
    }
</style>
