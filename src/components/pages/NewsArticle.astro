---
import { getLangFromUrl, useTranslations, useRoutes, brand } from '../../i18n/ui';
import { getNews, newsDate, newsSlug, type NewsEntry } from '../../lib/news';
import NewsCard from '../NewsCard.astro';

interface Props {
    entry: NewsEntry;
}

const { entry } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const r = useRoutes(lang);
const { Content } = await entry.render();
const more = (await getNews(lang)).filter((item) => newsSlug(item) !== newsSlug(entry)).slice(0, 2);
const { data } = entry;

// Para Google: la noticia como artículo, firmada por Juan y publicada por el estudio.
const site = 'https://volmer.es';
const articleData = {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    inLanguage: lang === 'es' ? 'es-ES' : 'en-GB',
    mainEntityOfPage: `${site}${r.news}${newsSlug(entry)}/`,
    image: [new URL(data.ogImage ?? data.image ?? (lang === 'es' ? '/og-image.png' : '/og-image-en.png'), site).href],
    author: { '@type': 'Person', name: brand.person, url: brand.portfolio },
    publisher: { '@type': 'Organization', name: brand.name, logo: { '@type': 'ImageObject', url: `${site}/icon-512.png` } },
};
---

<main class="relative pt-28 md:pt-36 pb-16">
    <script type="application/ld+json" set:html={JSON.stringify(articleData)} />
    <article class="max-w-3xl mx-auto px-6">
        <a href={r.news} class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-yellow-400 mb-8 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            {t('news.back')}
        </a>

        <header class="mb-10">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-bold uppercase tracking-wider mb-5">
                <span class="text-yellow-400">{data.tag}</span>
                <span class="w-1 h-1 rounded-full bg-gray-600"></span>
                <time datetime={data.date.toISOString().slice(0, 10)} class="text-gray-500">{newsDate(data.date, lang)}</time>
            </div>
            <h1 class="text-3xl md:text-5xl font-bold font-heading leading-tight mb-6 text-white">{data.title}</h1>
            <p class="text-lg md:text-xl text-gray-400 leading-relaxed">{data.description}</p>
        </header>

        {data.image && (
            <figure class="mb-10">
                <div class="rounded-xl overflow-hidden border border-white/10 shadow-2xl">
                    <img src={data.image} alt={data.imageAlt ?? ''} width={data.imageWidth} height={data.imageHeight} class="w-full h-auto" />
                </div>
                {data.imageCredit && <figcaption class="mt-2 text-xs text-gray-500">{data.imageCredit}</figcaption>}
            </figure>
        )}

        <div class="news-content text-gray-300 leading-relaxed text-lg">
            <Content />
        </div>

        {(data.links?.length || data.linkedin) && (
            <aside class="mt-10 pt-8 border-t border-white/10">
                <h2 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-4">{t('news.links')}</h2>
                <ul class="flex flex-col gap-2">
                    {data.links?.map((link) => (
                        <li>
                            <a href={link.href} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-neon-cyan hover:text-white transition-colors">
                                {link.label} <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform">↗</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </aside>
        )}

        <div class="mt-10 flex flex-wrap gap-3">
            <a href={data.linkedin ?? brand.linkedin} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 text-sm font-bold text-white bg-[#0A66C2] hover:bg-[#0a5bb0] rounded-full transition-colors">
                {data.linkedin ? t('news.linkedinPost') : t('news.follow')} ↗
            </a>
            <a href={r.contact} class="px-5 py-2.5 text-sm font-bold text-white bg-white/5 border border-white/15 hover:border-white/30 rounded-full transition-colors">
                {t('cta.contact')}
            </a>
        </div>
    </article>

    {more.length > 0 && (
        <section class="max-w-7xl mx-auto px-6 mt-20 pt-12 border-t border-white/5">
            <h2 data-reveal class="text-2xl md:text-3xl font-heading font-bold text-white mb-8">{t('news.more')}</h2>
            <div data-reveal-stagger class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl">
                {more.map((item) => <NewsCard item={item} />)}
            </div>
        </section>
    )}
</main>

<style is:global>
    @reference "../../styles/global.css";

    .news-content h2 {
        @apply text-2xl font-bold text-white mt-10 mb-4 font-heading;
    }
    .news-content p {
        @apply mb-6;
    }
    .news-content ul {
        @apply list-disc pl-6 mb-6;
    }
    .news-content li {
        @apply mb-2;
    }
    .news-content strong {
        @apply text-white;
    }
    .news-content a {
        @apply text-neon-cyan underline decoration-neon-cyan/30 hover:decoration-neon-cyan transition-all;
    }
</style>
