---
import { getLangFromUrl, useTranslations, useRoutes, brand } from '../../i18n/ui';
import { techStack } from '../../data/projects';
import ProcessSteps from '../ProcessSteps.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const r = useRoutes(lang);

const values = [
    {
        title: t('about.v1.title'),
        desc: t('about.v1.desc'),
        accent: 'text-neon-cyan',
        bg: 'bg-neon-cyan/10',
        icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
    },
    {
        title: t('about.v2.title'),
        desc: t('about.v2.desc'),
        accent: 'text-neon-pink',
        bg: 'bg-neon-pink/10',
        icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    },
    {
        title: t('about.v3.title'),
        desc: t('about.v3.desc'),
        accent: 'text-emerald-400',
        bg: 'bg-emerald-500/10',
        icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
    },
];

const credentials = [
    {
        label: t('about.cred42'),
        icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222',
        accent: 'text-neon-cyan',
        link: brand.wuriRanking,
    },
    {
        label: t('about.credEmbedded'),
        icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
        accent: 'text-violet-400',
        link: null,
    },
    {
        label: t('about.credDrone'),
        icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
        accent: 'text-emerald-400',
        link: null,
    },
];
---

<main class="relative pt-28 md:pt-36 pb-16">

    <!-- ============ HERO ============ -->
    <section class="max-w-7xl mx-auto px-6 mb-16 md:mb-24">
        <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neon-cyan/30 bg-neon-cyan/5 text-neon-cyan text-xs font-bold tracking-wider mb-6">
                <span class="w-2 h-2 rounded-full bg-neon-cyan"></span>
                {t('about.badge')}
            </div>
            <h1 class="font-heading text-4xl md:text-6xl font-bold leading-[1.05] mb-8">
                {t('about.title1')} <br />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-neon-pink">
                    {t('about.title2')}
                </span>
            </h1>
            <p class="text-lg md:text-xl text-gray-400 leading-relaxed max-w-2xl">
                {t('about.subtitle')}
            </p>
        </div>
    </section>

    <!-- ============ PRESENTACIÓN ============ -->
    <section class="max-w-7xl mx-auto px-6 mb-20 md:mb-28">
        <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-16 items-start">
            <!-- Retrato + credenciales -->
            <div class="mx-auto md:mx-0 w-full max-w-[280px]">
                <div class="relative w-full aspect-square rounded-2xl p-1.5 border border-white/10 bg-[#050505]/80 shadow-2xl mb-6">
                    <img
                        src="/profile.png"
                        alt={brand.person}
                        width="280"
                        height="280"
                        class="w-full h-full object-cover rounded-xl filter grayscale-[20%] contrast-[110%] hover:filter-none transition-all duration-500"
                    />
                </div>

                <ul class="space-y-3">
                    {credentials.map((cred) => (
                        <li>
                            {cred.link ? (
                                <a
                                    href={cred.link}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="flex items-start gap-3 p-3 rounded-xl bg-white/5 border border-white/10 hover:border-white/20 transition-colors"
                                >
                                    <svg class={`w-5 h-5 shrink-0 mt-0.5 ${cred.accent}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                                        <path stroke-linecap="round" stroke-linejoin="round" d={cred.icon} />
                                    </svg>
                                    <span class="text-xs text-gray-400 leading-relaxed">{cred.label}</span>
                                </a>
                            ) : (
                                <div class="flex items-start gap-3 p-3 rounded-xl bg-white/5 border border-white/10">
                                    <svg class={`w-5 h-5 shrink-0 mt-0.5 ${cred.accent}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                                        <path stroke-linecap="round" stroke-linejoin="round" d={cred.icon} />
                                    </svg>
                                    <span class="text-xs text-gray-400 leading-relaxed">{cred.label}</span>
                                </div>
                            )}
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Texto -->
            <div>
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-6">{t('about.introTitle')}</h2>
                <div class="space-y-5 text-gray-400 leading-relaxed md:text-lg">
                    <p>{t('about.introP1')}</p>
                    <p>{t('about.introP2')}</p>
                    <p>{t('about.introP3')}</p>
                </div>

                <!-- Tecnologías -->
                <div class="mt-10 pt-8 border-t border-white/5">
                    <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-4">{t('about.skillsTitle')}</h3>
                    <div class="flex flex-wrap gap-2">
                        {techStack.map((tech) => (
                            <span
                                class="text-xs font-bold px-3 py-1.5 rounded-lg bg-white/5 border border-white/10"
                                style={`color: ${tech.color}`}
                            >
                                {tech.name}
                            </span>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ VALORES ============ -->
    <section class="max-w-7xl mx-auto px-6 mb-20 md:mb-28">
        <h2 class="text-2xl md:text-4xl font-heading font-bold text-white mb-12 text-center">{t('about.valuesTitle')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {values.map((value) => (
                <div class="p-6 md:p-8 rounded-2xl bg-[#0a0a0a] border border-white/10 hover:border-white/20 transition-all">
                    <div class={`w-12 h-12 mb-5 rounded-lg flex items-center justify-center ${value.bg} ${value.accent}`}>
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d={value.icon} />
                        </svg>
                    </div>
                    <h3 class="text-xl font-heading font-bold text-white mb-3">{value.title}</h3>
                    <p class="text-sm text-gray-400 leading-relaxed">{value.desc}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- ============ PROCESO ============ -->
    <section class="max-w-7xl mx-auto px-6 mb-20 md:mb-28">
        <h2 class="text-2xl md:text-4xl font-heading font-bold mb-14 text-center text-white">{t('process.title')}</h2>
        <ProcessSteps />
    </section>

    <!-- ============ CTA ============ -->
    <section class="max-w-5xl mx-auto px-6">
        <div class="relative text-center py-14 md:py-20 px-6 bg-gradient-to-tr from-white/5 to-transparent rounded-3xl border border-white/10 overflow-hidden">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-neon-cyan/10 rounded-full blur-[100px] -z-10"></div>

            <h2 class="text-3xl md:text-5xl font-heading font-bold mb-5 text-white">{t('home.finalTitle')}</h2>
            <p class="text-base md:text-lg text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed">{t('home.finalSubtitle')}</p>

            <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
                <button class="open-quote-modal w-full sm:w-auto px-8 py-4 text-base font-bold text-dark-bg bg-neon-cyan hover:bg-white transition-all rounded-full shadow-[0_0_20px_rgba(5,217,232,0.4)]">
                    {t('cta.quote')}
                </button>
                <a href={r.projects} class="w-full sm:w-auto px-8 py-4 text-base font-bold text-white bg-white/5 border border-white/15 hover:bg-white/10 hover:border-white/30 transition-all rounded-full">
                    {t('cta.projects')}
                </a>
            </div>
        </div>
    </section>
</main>
