---
import { getLangFromUrl, useTranslations, ui } from '../i18n/ui';
import { accents } from '../data/accents';
import type { Service } from '../data/services';

interface Props {
    /** Nivel del título: h2 en /servicios, donde las tarjetas cuelgan del h1. */
    heading?: 'h2' | 'h3';
    service: Service;
    /** Muestra la lista de puntos incluidos. Se usa en /servicios, no en la home. */
    detailed?: boolean;
}

const { service, detailed = false, heading: Heading = 'h3' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const a = accents[service.accent];

type Key = keyof (typeof ui)['es'];
const features = detailed
    ? (['f1', 'f2', 'f3', 'f4'] as const).map((n) => t(`services.${service.key}.${n}` as Key))
    : [];
---

<article
    id={service.id}
    class:list={[
        "group relative p-6 md:p-8 rounded-2xl bg-[#0a0a0a] border border-white/10 transition-all duration-300 overflow-hidden h-full scroll-mt-28",
        a.borderHover,
        a.glow,
    ]}
>
    <div class:list={["absolute top-0 right-0 w-32 h-32 rounded-full blur-[50px] transition-all", a.bgSoft]}></div>

    <div class="relative z-10 flex flex-col h-full">
        <div class:list={["w-12 h-12 mb-6 rounded-lg flex items-center justify-center", a.bgSoft, a.text]}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
            </svg>
        </div>

        <Heading class:list={["text-xl md:text-2xl font-heading font-bold mb-3 text-white transition-colors", a.textHover]}>
            {t(`services.${service.key}.title` as Key)}
        </Heading>

        <p class="text-gray-400 leading-relaxed text-sm md:text-base">
            {t(`services.${service.key}.desc` as Key)}
        </p>

        {detailed && (
            <ul class="space-y-2.5 text-sm text-gray-500 mt-6">
                {features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                        <span class:list={["w-1.5 h-1.5 rounded-full mt-1.5 shrink-0", a.dot]}></span>
                        <span>{feature}</span>
                    </li>
                ))}
            </ul>
        )}
    </div>
</article>
