---
import Layout from '../../layouts/Layout.astro';
import NewsArticle from '../../components/pages/NewsArticle.astro';
import { getNews, newsSlug } from '../../lib/news';

export async function getStaticPaths() {
    return (await getNews('es')).map((entry) => ({ params: { slug: newsSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<Layout
    title={`${entry.data.title} | Volmer Studio`}
    description={entry.data.description}
    image={entry.data.ogImage ?? entry.data.image}
    type="article"
    rss="/noticias/rss.xml"
>
    <NewsArticle entry={entry} />
</Layout>
